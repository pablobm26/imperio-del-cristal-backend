# Copia este archivo a .env (o carga las variables en el dashboard de Render).
# La explicación de cada una, y qué pasa exactamente si falta, está en README.md
# → sección "Variables de entorno".

# --- Panel de administración -------------------------------------------------
# OJO: este repositorio es PÚBLICO. Los valores por defecto que tiene el código
# para estas variables están a la vista de cualquiera, así que dejarlas sin
# configurar equivale a no tener contraseña.
ADMIN_PASSWORD=elige-una-contraseña-fuerte-aqui
ADMIN_USERNAME=admin

# Cuenta de la pantalla de escaneo de salidas.
SALIDAS_USERNAME=
SALIDAS_PASSWORD=

# Clave HMAC que firma los tokens de sesión del panel. Nadie la tipea: vive solo
# en el servidor. Con el valor por defecto del código, cualquiera puede firmarse
# un token de admin y saltearse el login entero. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# --- Integraciones -----------------------------------------------------------
# Chatbot con Claude. Sin esto, POST /api/chat responde 500 y el resto sigue
# funcionando. Conseguirla en https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Sincronización automática con PLADE SOFTWARE (getInventario) y envío de
# pedidos (savePedidoExterno). Las 3 van juntas: si falta una, la integración
# queda apagada entera y el catálogo se queda con el último CSV subido a mano.
# Ver el manual de PLADE para los valores reales.
PLADE_USER=
PLADE_PASSWORD=
PLADE_TOKEN=

# Overrides del cliente de PLADE. Normalmente NO hace falta tocarlos: el código
# ya trae los valores correctos por defecto. Ver README.md para el detalle.
# Nota: PLADE ignora los dos últimos — la factura siempre cae en el cliente 381
# y el almacén 1 sin importar lo que se envíe, así que cambiarlos no tiene
# ningún efecto.
PLADE_HOST=
PLADE_GENERIC_CLIENT_IDC=
PLADE_ONLINE_ALMACEN_ID=

# Cuentas + niveles de fidelidad (Supabase). Si se dejan vacías, el checkout
# sigue funcionando como invitado, sin descuento — no rompe nada.
# SUPABASE_SERVICE_ROLE_KEY nunca va en Vercel/frontend ni se commitea: solo
# vive acá y en el dashboard de Render. Ver supabase/README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correos de recordatorio de carrito abandonado (Resend). Van juntas.
RESEND_API_KEY=
CART_REMINDER_FROM_EMAIL=

# Protege el endpoint del cron diario que dispara esos recordatorios. Sin esto
# el endpoint rechaza todo, así que los correos nunca se envían.
CRON_SECRET=

# Validación automática de Pago Móvil con la API de Mercantil (cuenta JURÍDICA).
# Las 5 primeras las entrega el banco al comercio; MERCANTIL_MERCHANT_PHONE es el
# teléfono afiliado a esa cuenta. Si falta cualquiera, la validación queda apagada
# y los pagos se siguen confirmando a mano, como hasta ahora — no rompe nada.
# MERCANTIL_BASE_URL apunta al SANDBOX por defecto: solo se cambia a producción
# cuando el banco entregue las credenciales definitivas.
# Ver PROPUESTA-PAGO-MOVIL-MERCANTIL.md en la raíz del proyecto.
MERCANTIL_CLIENT_ID=
MERCANTIL_MERCHANT_ID=
MERCANTIL_INTEGRATOR_ID=
MERCANTIL_TERMINAL_ID=
MERCANTIL_SECRET_KEY=
MERCANTIL_MERCHANT_PHONE=
MERCANTIL_BASE_URL=
# Solo para la prueba en sandbox: ponerla en 1 manda el campo con el nombre mal
# escrito que usa la colección de Postman del banco (destinantion_mobile_number),
# por si el nombre correcto no encuentra nada. Ver la propuesta, sección 2.5.
MERCANTIL_TYPO_DESTINATION=
# El ejemplo oficial de /mobile-payment/search NO manda la cedula del cliente. Ponerlo en 1
# solo si en certificacion se comprueba que el API la acepta.
MERCANTIL_SEARCH_WITH_ID=


# --- Infraestructura ---------------------------------------------------------
# Solo en Render, si el servicio tiene un disco persistente: la ruta donde está
# montado (ej. /var/data). Sin esta variable los datos van a la carpeta data/
# del repo, que Render borra en cada redeploy si no hay disco.
DATA_DIR=

# Render define PORT sola; en local, 3000 por defecto.
PORT=3000

# Dominio usado para armar los links de los correos. Por defecto ya apunta a
# https://cristal44.com — solo hace falta si el dominio cambia.
STORE_URL=
